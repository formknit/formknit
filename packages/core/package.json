{
  "name": "@formknit/core",
  "version": "0.1.1",
  "description": "Schema, validation and formula engine for Formknit forms. No dependencies; runs in browsers, Node and Bun.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/fields.ts",
    "./dist/*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formknit/formknit.git",
    "directory": "packages/core"
  }
}
