# Settings for `docker compose up`. Copy to .env and fill in.

# The address people will open in their browser, with no trailing slash.
WEB_ORIGIN=http://localhost:8787

# Password for the bundled PostgreSQL. Use letters and digits only, as it is placed inside an address.
POSTGRES_PASSWORD=

# Port on this machine.
PORT=8787

# Mail server for password resets, invitations and notifications. Leave empty to send nothing.
# Special characters in the password must be percent-encoded (@ becomes %40).
SMTP_URL=
MAIL_FROM=Formknit <no-reply@example.com>

# "invite": only the first account, and people invited to a workspace, can sign up.
# "open": anyone can create an account.
REGISTRATION=invite
