{
  "name": "formknit-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @formknit/playground dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "changeset": "changeset",
    "release": "pnpm -r build && pnpm -r test && changeset publish",
    "docs:dev": "pnpm --filter @formknit/docs dev",
    "docs:build": "pnpm --filter @formknit/docs build",
    "dev:api": "pnpm --filter @formknit/api dev",
    "dev:web": "pnpm --filter @formknit/web dev",
    "seed": "pnpm --filter @formknit/api seed"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
